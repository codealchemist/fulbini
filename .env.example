# Get your key from https://dashboard.api-football.com (API-Sports account, not RapidAPI).
# Used only by the Netlify Function proxy (netlify/functions/football.mts) — never exposed to the browser.
# Locally: copy this file to .env and run `npm run dev` (netlify dev picks it up automatically).
# In production: set this in Netlify > Site configuration > Environment variables.
API_FOOTBALL_KEY=
