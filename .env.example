# Get your key from https://dashboard.api-football.com (API-Sports account, not RapidAPI).
# Used only by the Netlify Function proxy (netlify/functions/football.mts) — never exposed to the browser.
# Locally: copy this file to .env and run `npm run dev` (netlify dev picks it up automatically).
# In production: set this in Netlify > Site configuration > Environment variables.
API_FOOTBALL_KEY=

# Multiple API-Football accounts (optional): set this instead of the single
# key above to load-balance requests round robin across them, so combined
# daily quota scales with the number of accounts. Comma-separated, no spaces
# needed around commas. If unset, API_FOOTBALL_KEY above is used as-is.
# See netlify/functions/lib/apiKeys.ts.
API_FOOTBALL_KEYS=

# Optional, local dev only: skip Netlify Identity entirely with a fake signed-in
# session. Real Google/Identity login can't work against localhost (see README
# "Local development without Identity") — this unblocks everything else.
# Has no effect in a production build (see src/context/AuthContext.tsx).
VITE_DEV_BYPASS_AUTH=
